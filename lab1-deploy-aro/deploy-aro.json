{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "clusterName": {
      "type": "string",
      "defaultValue": "aro-cluster",
      "metadata": {
        "description": "Name of the ARO cluster"
      }
    },
    "vnetName": {
      "type": "string",
      "defaultValue": "aro-vnet",
      "metadata": {
        "description": "Name of the virtual network"
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/22",
      "metadata": {
        "description": "Address prefix for the virtual network"
      }
    },
    "masterSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/23",
      "metadata": {
        "description": "Address prefix for the master subnet"
      }
    },
    "workerSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.0.2.0/23",
      "metadata": {
        "description": "Address prefix for the worker subnet"
      }
    },
    "pullSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Red Hat pull secret (optional)"
      }
    },
    "domain": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Domain prefix for the cluster (optional)"
      }
    }
  },
  "variables": {
    "masterSubnetName": "master-subnet",
    "workerSubnetName": "worker-subnet",
    "vnetId": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]",
    "masterSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), variables('masterSubnetName'))]",
    "workerSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), variables('workerSubnetName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2021-02-01",
      "name": "[parameters('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetAddressPrefix')]"
          ]
        }
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2021-02-01",
      "name": "[concat(parameters('vnetName'), '/', variables('masterSubnetName'))]",
      "dependsOn": [
        "[variables('vnetId')]"
      ],
      "properties": {
        "addressPrefix": "[parameters('masterSubnetPrefix')]",
        "serviceEndpoints": [
          {
            "service": "Microsoft.ContainerRegistry"
          }
        ],
        "privateLinkServiceNetworkPolicies": "Disabled"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2021-02-01",
      "name": "[concat(parameters('vnetName'), '/', variables('workerSubnetName'))]",
      "dependsOn": [
        "[variables('vnetId')]",
        "[variables('masterSubnetId')]"
      ],
      "properties": {
        "addressPrefix": "[parameters('workerSubnetPrefix')]",
        "serviceEndpoints": [
          {
            "service": "Microsoft.ContainerRegistry"
          }
        ]
      }
    },
    {
      "type": "Microsoft.RedHatOpenShift/openShiftClusters",
      "apiVersion": "2022-04-01",
      "name": "[parameters('clusterName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[variables('masterSubnetId')]",
        "[variables('workerSubnetId')]"
      ],
      "properties": {
        "clusterProfile": {
          "domain": "[if(empty(parameters('domain')), parameters('clusterName'), parameters('domain'))]",
          "resourceGroupId": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', 'aro-', parameters('clusterName'), '-', uniqueString(resourceGroup().id))]",
          "pullSecret": "[if(empty(parameters('pullSecret')), json('null'), parameters('pullSecret'))]"
        },
        "networkProfile": {
          "podCidr": "10.128.0.0/14",
          "serviceCidr": "172.30.0.0/16"
        },
        "servicePrincipalProfile": {
          "clientId": "",
          "clientSecret": ""
        },
        "masterProfile": {
          "vmSize": "Standard_D8s_v3",
          "subnetId": "[variables('masterSubnetId')]",
          "encryptionAtHost": "Disabled"
        },
        "workerProfiles": [
          {
            "name": "worker",
            "vmSize": "Standard_D4s_v3",
            "diskSizeGB": 128,
            "subnetId": "[variables('workerSubnetId')]",
            "count": 3,
            "encryptionAtHost": "Disabled"
          }
        ],
        "apiserverProfile": {
          "visibility": "Public"
        },
        "ingressProfiles": [
          {
            "name": "default",
            "visibility": "Public"
          }
        ]
      }
    }
  ],
  "outputs": {
    "clusterName": {
      "type": "string",
      "value": "[parameters('clusterName')]"
    },
    "consoleUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.RedHatOpenShift/openShiftClusters', parameters('clusterName'))).consoleProfile.url]"
    },
    "apiServerUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.RedHatOpenShift/openShiftClusters', parameters('clusterName'))).apiserverProfile.url]"
    }
  }
}
