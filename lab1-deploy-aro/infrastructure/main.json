{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.38.33.27573",
      "templateHash": "2602107866665805301"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "clusterName": {
      "type": "string",
      "defaultValue": "aro-cluster",
      "metadata": {
        "description": "Name of the ARO cluster"
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/22",
      "metadata": {
        "description": "Address prefix for the virtual network"
      }
    },
    "masterSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/23",
      "metadata": {
        "description": "Address prefix for the master subnet"
      }
    },
    "workerSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.0.2.0/23",
      "metadata": {
        "description": "Address prefix for the worker subnet"
      }
    },
    "domain": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional domain prefix for the cluster; defaults to clusterName when empty"
      }
    },
    "pullSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Red Hat pull secret (optional). Leave empty to skip."
      }
    },
    "spClientId": {
      "type": "string",
      "metadata": {
        "description": "Service principal client ID (mandatory for ARO ARM deployment)"
      }
    },
    "spClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Service principal client secret (mandatory for ARO ARM deployment)"
      }
    },
    "workerVmSize": {
      "type": "string",
      "defaultValue": "Standard_D4s_v3",
      "metadata": {
        "description": "Worker VM size"
      }
    },
    "workerCount": {
      "type": "int",
      "defaultValue": 3,
      "minValue": 3,
      "metadata": {
        "description": "Number of worker nodes"
      }
    },
    "masterVmSize": {
      "type": "string",
      "defaultValue": "Standard_D8s_v3",
      "metadata": {
        "description": "Master VM size"
      }
    },
    "internalSuffix": {
      "type": "string",
      "defaultValue": "int",
      "metadata": {
        "description": "Internal cluster RG suffix (short, deterministic)"
      }
    },
    "openshiftVersion": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "OpenShift version (from az aro get-versions -l <region>). Leave empty for default latest."
      }
    },
    "fipsValidatedModules": {
      "type": "string",
      "defaultValue": "Disabled",
      "metadata": {
        "description": "FIPS validated modules setting: Enabled or Disabled"
      }
    }
  },
  "variables": {
    "vnetName": "aro-vnet",
    "masterSubnetName": "master-subnet",
    "workerSubnetName": "worker-subnet",
    "internalClusterRg": "[format('/subscriptions/{0}/resourceGroups/aro-{1}-{2}', subscription().subscriptionId, parameters('clusterName'), parameters('internalSuffix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2021-02-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetAddressPrefix')]"
          ]
        }
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2021-02-01",
      "name": "[format('{0}/{1}', variables('vnetName'), variables('masterSubnetName'))]",
      "properties": {
        "addressPrefix": "[parameters('masterSubnetPrefix')]",
        "serviceEndpoints": [
          {
            "service": "Microsoft.ContainerRegistry"
          }
        ],
        "privateLinkServiceNetworkPolicies": "Disabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2021-02-01",
      "name": "[format('{0}/{1}', variables('vnetName'), variables('workerSubnetName'))]",
      "properties": {
        "addressPrefix": "[parameters('workerSubnetPrefix')]",
        "serviceEndpoints": [
          {
            "service": "Microsoft.ContainerRegistry"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/subnets', split(format('{0}/{1}', variables('vnetName'), variables('masterSubnetName')), '/')[0], split(format('{0}/{1}', variables('vnetName'), variables('masterSubnetName')), '/')[1])]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    }
  ],
  "outputs": {
    "vnetName": {
      "type": "string",
      "value": "[variables('vnetName')]"
    },
    "masterSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', split(format('{0}/{1}', variables('vnetName'), variables('masterSubnetName')), '/')[0], split(format('{0}/{1}', variables('vnetName'), variables('masterSubnetName')), '/')[1])]"
    },
    "workerSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', split(format('{0}/{1}', variables('vnetName'), variables('workerSubnetName')), '/')[0], split(format('{0}/{1}', variables('vnetName'), variables('workerSubnetName')), '/')[1])]"
    }
  }
}