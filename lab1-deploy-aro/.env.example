# Copy to .env and fill in required values
# Resource group that YOU create (outer RG)
ARO_RG=rg-aro-lab-001
LOCATION=centralus
CLUSTER_NAME=aro-cluster
INTERNAL_SUFFIX=int

# Optional service principal (leave blank for managed identity if supported)
SP_CLIENT_ID=
SP_CLIENT_SECRET=
# If left blank you can set AUTO_CREATE_SP=true to have deploy.sh create one
AUTO_CREATE_SP=false

# Red Hat pull secret (provide raw JSON string or leave empty)
PULL_SECRET=

# Worker customization
WORKER_COUNT=3
WORKER_VM_SIZE=Standard_D4s_v3
MASTER_VM_SIZE=Standard_D8s_v3
OPENSHIFT_VERSION=
# Set to a value from: az aro get-versions -l $LOCATION (e.g. 4.17.27). Leave blank for latest.
