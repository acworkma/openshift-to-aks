# Lab 3 AKS Deployment Configuration
# Copy to .env and adjust as needed

# Azure region for AKS
AKS_LOCATION=eastus

# Resource group (auto-created if absent)
AKS_RG=rg-aks-lab-eastus

# Cluster name
AKS_CLUSTER_NAME=aks-cluster

# Node sizing
AKS_NODE_SIZE=Standard_D2s_v3
AKS_NODE_COUNT=3

# Autoscaler settings
AKS_ENABLE_AUTOSCALER=true
AKS_MIN_COUNT=1
AKS_MAX_COUNT=5

# Kubernetes version (leave blank for latest stable GA)
AKS_VERSION=

# Networking
AKS_NETWORK_PLUGIN=azure   # azure | kubenet
AKS_NETWORK_POLICY=        # optional: azure | calico

# Monitoring addon (OMS / Container Insights)
AKS_ENABLE_MONITORING=false

# RBAC
AKS_ENABLE_RBAC=true

# Managed identity type
AKS_IDENTITY_TYPE=SystemAssigned

# Cleanup behavior (when running cleanup.sh)
CLEANUP_DELETE_RG=false

# Local simulation settings
SIMULATE_LOCAL=false
KIND_CLUSTER_NAME=aks-sim
SIM_NODE_COUNT=3