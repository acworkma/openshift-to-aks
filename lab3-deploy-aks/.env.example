# Lab 3 AKS Deployment Configuration (Streamlined)
# Copy to .env and adjust as needed

# Azure region for AKS
AKS_LOCATION=australiaeast

# Resource group (auto-created if absent)
AKS_RG=rg-aks-lab3-aue

# Cluster name
AKS_CLUSTER_NAME=aks-lab3

# Node sizing
AKS_NODE_SIZE=Standard_D2s_v3
AKS_NODE_COUNT=3


# Cleanup behavior (when running cleanup.sh)
CLEANUP_DELETE_RG=false